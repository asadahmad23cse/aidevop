# HealthRAG AI - environment configuration
# Copy to .env and adjust as needed:  cp .env.example .env

# ── Ports (host side) ─────────────────────────────────────────
APP_PORT=8001
OLLAMA_PORT=11434

# ── Retrieval ────────────────────────────────────────────────
# lexical  = lightweight, no ML deps (default, ships in the image)
# semantic = FAISS + sentence-transformers (install them in the image first)
RETRIEVAL_BACKEND=lexical
RAG_INDEX_DIR=/app/outputs/rag_index

# ── LLM routing (Ollama tags, PRD section 3) ─────────────────
# The app never downloads these - pull them once (see README).
LLM_MODEL_EASY=qwen2.5:0.5b
LLM_MODEL_MEDIUM=gemma3:1b
LLM_MODEL_COMPLEX=smollm2:1.7b

# Seconds to wait for an Ollama generation before falling back.
OLLAMA_TIMEOUT=120

# ── Optional cloud fallback (leave blank to disable) ─────────
# OPENAI_API_KEY=
# GROQ_API_KEY=
